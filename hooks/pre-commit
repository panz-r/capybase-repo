#!/usr/bin/env bash
#
# pre-commit guard — no environment-specific endpoint identifiers in tracked
# files. Blocks STAGED ADDITIONS containing:
#
#   - IPv4 literals other than the loopback/any/broadcast allowlist
#     (127.0.0.1, 0.0.0.0, 255.255.255.255)
#   - mDNS machine hostnames (*.local) and Windows-style hyphenated
#     desktop-PC machine names
#   - the local host's name (NOVA), including provider names built on it  # endpoint-guard: allow
#     (nova-gemma4, nova_vibethinker) — a provider-config name is a host  # endpoint-guard: allow
#     identifier when it encodes the machine it points at
#
# Intentional exceptions (e.g. the guard's own test fixtures, harvest
# provenance quoting the command that actually ran) mark the line:
#     something-with-an-ip  # endpoint-guard: allow
#
# Hosts, IPs, and machine names belong in provider configs under
# ~/.config/capybase/providers/ (see src/capybase/provider_config.py) or the
# user-level capybase.toml — never inside the repository.
#
# README terminology guard (2026-09-18): staged additions to README.md
# must keep the accepted vocabulary — no 'harvest', no 'monster', no
# internal process-doc names (PLAN-LEDGER etc.), no sprint worklog codes
# (SNN-NN). Exceptions mark the line:
#     the-word  # readme-guard: allow
#
# Corpus-source guard (2026-09-19): external repository sources and cases
# derived from them NEVER enter tracking — they are regenerated by scripts
# (scripts/fetch_mergeconflict_datasets.py, corpus loaders) into gitignored
# landing zones. Blocks staged ADDITIONS that are:
#   - under the dataset landing dirs (external-datasets/, extracted-testdata/,
#     downloads/) — except each dir's own .gitignore placeholder
#   - a single file >= 2,000,000 bytes (bulk vendoring / archives; the largest
#     legitimate tracked file today is ~1.03 MB)
#   - part of a >50-file batch added under one directory in a single commit
#     (a copied external tree; split the commit or mark files explicitly)
# Deliberate exceptions mark a line IN the staged file:
#     anything  # corpus-guard: allow
#
# Install once per clone:  git config core.hooksPath hooks
#
set -uo pipefail

ALLOWED_IPS=" 127.0.0.1 0.0.0.0 255.255.255.255 "
CORPUS_SIZE_CAP=2000000
CORPUS_BATCH_LIMIT=50

violations=0
file=""
while IFS= read -r line; do
    case "$line" in
        "+++ b/"*) file="${line#"+++ b/"}"; continue ;;
        +*) ;; # an added line — inspect its content
        *) continue ;;
    esac
    content="${line#+}"

    # Explicit, auditable per-line opt-out (guard fixtures, docs quoting an
    # endpoint deliberately). The marker itself is greppable for review.
    case "$content" in
        *endpoint-guard:*allow*) continue ;;
    esac

    # IPv4 literals, minus the allowlist.
    for ip in $(printf '%s\n' "$content" | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' || true); do
        case "$ALLOWED_IPS" in
            *" $ip "*) ;; # allowlisted (loopback/any) — not infra-specific
            *)
                echo "pre-commit: IPv4 literal '$ip' staged in $file" >&2
                violations=1
                ;;
        esac
    done

    # mDNS hostnames (host.local[:port]/path) — LAN machine identity.
    if printf '%s\n' "$content" | grep -qiE '[a-z0-9-]+\.local([:/[:space:]]|$)'; then
        echo "pre-commit: mDNS hostname (*.local) staged in $file" >&2
        violations=1
    fi

    # Windows-style machine names (hyphenated desktop-PC hostnames).
    if printf '%s\n' "$content" | grep -qE '[[:space:](/]DESKTOP-[A-Z0-9-]+' \
        || printf '%s\n' "$content" | grep -qE '^DESKTOP-[A-Z0-9-]+'; then
        echo "pre-commit: machine name (DESKTOP-*) staged in $file" >&2
        violations=1
    fi

    # Local host's name — standalone or as a provider-name prefix
    # (nova-gemma4, nova_vibethinker). Word-boundary anchored so ordinary  # endpoint-guard: allow
    # words containing the letters (supernova) pass.
    if printf '%s\n' "$content" | grep -qiE '(\bnova\b|\bnova[-_])'; then
        echo "pre-commit: host name (nova*) staged in $file" >&2  # endpoint-guard: allow
        violations=1
    fi

    # README terminology guard — README.md additions only. The README's
    # accepted vocabulary (2026-09-18): 'full run' not 'harvest'; 'the
    # larger corpus' not tier/monster names; internal process docs and
    # sprint-worklog codes never appear. Legitimate pre-existing uses
    # elsewhere ("acceptance tier", the Test-suites "Three tiers") are
    # untouched — this block only fires for README.md.
    if [ "$file" = "README.md" ]; then
        case "$content" in
            *readme-guard:*allow*) ;;
            *)
                if printf '%s\n' "$content" | grep -qiE '\bharvest(s|ed|ing)?\b'; then
                    echo "pre-commit: 'harvest' staged in README.md (use 'full run'/'round') — $file" >&2
                    violations=1
                fi
                if printf '%s\n' "$content" | grep -qiE '\bmonster\b'; then
                    echo "pre-commit: 'monster' staged in README.md (use 'the larger corpus') — $file" >&2
                    violations=1
                fi
                if printf '%s\n' "$content" | grep -qE 'PLAN-LEDGER|RESUME\.md|README-SECTION-REWRITE-PROCESS'; then
                    echo "pre-commit: internal process-doc name staged in README.md — $file" >&2
                    violations=1
                fi
                if printf '%s\n' "$content" | grep -qE '\bS[0-9]+-[0-9]+\b'; then
                    echo "pre-commit: sprint worklog code (SNN-NN) staged in README.md — $file" >&2
                    violations=1
                fi
                ;;
        esac
    fi
done < <(git diff --cached --no-color -U0)

# --------------------------------------------------------------------------
# Corpus-source guard — file-level pass over STAGED ADDITIONS.
# --------------------------------------------------------------------------
_marker_in_staged() {
    # True when the STAGED blob carries the corpus-guard allow marker.
    git cat-file -p ":$1" 2>/dev/null | grep -q 'corpus-guard: allow'
}

while IFS= read -r added; do
    [ -n "$added" ] || continue

    # Landing dirs for fetched/derived corpus data: everything is generated
    # there and gitignored; only each dir's .gitignore placeholder tracks.
    case "$added" in
        external-datasets/*|extracted-testdata/*|downloads/*)
            case "${added##*/}" in
                .gitignore) ;;
                *)
                    if ! _marker_in_staged "$added"; then
                        echo "pre-commit: external/derived corpus data staged at $added" >&2
                        echo "  (corpus sources are generated by scripts into gitignored dirs — never committed)" >&2
                        violations=1
                    fi
                    ;;
            esac
            ;;
    esac

    # Bulk-copy size cap.
    if [ -f "$added" ]; then
        bytes=$(wc -c < "$added")
        if [ "$bytes" -ge "$CORPUS_SIZE_CAP" ] && ! _marker_in_staged "$added"; then
            echo "pre-commit: staged file $added is $bytes bytes (cap $CORPUS_SIZE_CAP)" >&2
            echo "  (bulk external/archived content must not enter the repo)" >&2
            violations=1
        fi
    fi
done < <(git diff --cached --no-renames --name-only --diff-filter=A)

# >50-file batch added under one directory — a copied external tree.
batch_dir=$(git diff --cached --no-renames --name-only --diff-filter=A \
    | while IFS= read -r added; do
        [ -n "$added" ] || continue
        _marker_in_staged "$added" || dirname "$added"
      done | sort | uniq -c | awk -v limit="$CORPUS_BATCH_LIMIT" '$1 > limit {print $2; exit}')
if [ -n "$batch_dir" ]; then
    echo "pre-commit: more than $CORPUS_BATCH_LIMIT new files staged under $batch_dir" >&2
    echo "  (a batch that large looks like a copied external tree; split the commit or" >&2
    echo "   mark files '# corpus-guard: allow')" >&2
    violations=1
fi

if [ "$violations" -ne 0 ]; then
    echo >&2
    echo "Refusing commit: environment-specific endpoints must not enter the repo," >&2
    echo "external corpus sources/derived cases are never committed (scripts regenerate" >&2
    echo "them into gitignored dirs), and the README keeps its accepted vocabulary." >&2
    echo "Endpoints: put hosts in ~/.config/capybase/providers/<name>.json (provider" >&2
    echo "configs) or the user-level capybase.toml — see src/capybase/provider_config.py." >&2
    echo "Corpus data: regenerate via scripts/fetch_mergeconflict_datasets.py; an" >&2
    echo "intentional exception marks a line '# corpus-guard: allow' (greppable)." >&2
    echo "README terms: mark an intentional exception '# readme-guard: allow' (greppable)." >&2
    exit 1
fi
exit 0
